{
  // The Cloudflare Worker `opennextjs-cloudflare build` produces.
  //
  // This is how the application ships. Not a second target, not a spare: the
  // Workers Builds Git integration connected to this repository is the only
  // thing that deploys it.
  //
  //   push to `main`      → `npx wrangler deploy`          → production
  //   push to any branch  → `npx wrangler versions upload` → a preview version
  //
  // Those two commands, and the production branch they key off, are set in the
  // Cloudflare dashboard — not here, and not anywhere in this repository. So a
  // question about which branch goes live is never answered by reading this
  // file. It is answered under Workers & Pages → `ops-talaliving` → Settings →
  // Builds.
  //
  // (There is a Vercel project in this organisation. It belongs to the *old*
  // repository and serves previews there. It has nothing to do with this one,
  // whatever older comments in this repository may say.)
  //
  // Note what is NOT here: no `routes`, no custom domain. Until one is added,
  // a production deploy is reachable only on its own `workers.dev` URL, and
  // pointing `ops.talaliving.com` at this Worker is a deliberate, separate
  // step — a DNS cutover, not a side effect of merging.
  //
  // Deliberately small. There is no R2 incremental cache, no self-reference
  // service binding and no Images binding, because this application has
  // nothing that would use them: every screen is a client component reading
  // browser-held fixtures or Supabase from the browser, there are no route
  // handlers, no middleware, no `next/image`, and no ISR to cache. A binding
  // pointing at a bucket nobody created is a deploy that fails at the worst
  // moment; add them here the day a server route actually needs one. That day
  // is more likely now that this is the production host, not less.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ops-talaliving",
  "main": ".open-next/worker.js",

  // `nodejs_compat` is required by the adapter — Next's server runtime reaches
  // for node builtins regardless of how little of it this app uses.
  // `global_fetch_strictly_public` makes `fetch()` inside the worker go out to
  // the public internet rather than looping back into this same worker, which
  // is what Next assumes when it fetches its own routes.
  "compatibility_date": "2026-09-17",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],

  // The static half of the build — everything under `.open-next/assets` is
  // served from Cloudflare's edge without waking the worker at all.
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  }
}
