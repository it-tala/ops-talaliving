{
  "extends": "next/core-web-vitals",
  "rules": {
    "no-restricted-imports": [
      "error",
      {
        "patterns": [
          {
            "group": [
              "@/services/identity/*",
              "@/services/procurement/*",
              "@/services/accounting/*",
              "@/services/documents/*",
              "@/services/events/*",
              "@/services/hr/*",
              "@/services/production/*",
              "@/services/inventory/*",
              "@/services/marketing/*",
              "@/services/delivery/*",
              "@/services/assistant/*"
            ],
            "message": "Services may not import each other. Cross-service data goes through the service's own API (ADR-004). This rule does not apply to screens or to src/demo, which are clients of every service."
          }
        ]
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "src/app/**",
        "src/components/**",
        "src/demo/**",
        "src/lib/**",
        "src/store/**"
      ],
      "rules": { "no-restricted-imports": "off" }
    },
    {
      "files": ["src/services/*/contracts.ts"],
      "rules": { "no-restricted-imports": "off" }
    }
  ]
}
